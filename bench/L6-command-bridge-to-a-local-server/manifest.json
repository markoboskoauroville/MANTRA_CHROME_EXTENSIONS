{
  "manifest_version": 3,
  "name": "Mantra Bridge",
  "version": "1.0.0",
  "description": "Bridges local Queen API commands to the active browser tab.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ]
}
