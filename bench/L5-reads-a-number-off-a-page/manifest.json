{
  "manifest_version": 3,
  "name": "Mantra Credits",
  "version": "1.0.0",
  "description": "Captures the first dollar amount on platform.claude.com and stores it locally.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://platform.claude.com/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
