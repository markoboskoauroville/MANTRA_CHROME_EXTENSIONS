{
  "manifest_version": 3,
  "name": "Mantra Credits",
  "version": "1.0.0",
  "description": "Tracks Claude credits.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://platform.claude.com/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
